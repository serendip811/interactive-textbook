{
  "name": "interactive-textbook",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "scripts": {
    "audit:rc1": "node scripts/audit-rc1.mjs",
    "extract:harmony:batch-a": "node scripts/extract-harmony-batch-a.mjs",
    "extract:harmony:batch-b": "node scripts/extract-harmony-batch-b.mjs",
    "extract:harmony:batch-c": "node scripts/extract-harmony-batch-c.mjs",
    "extract:harmony:batch-d": "node scripts/extract-harmony-batch-d.mjs",
    "extract:harmony:batch-e": "node scripts/extract-harmony-batch-e.mjs",
    "extract:harmony:checkpoints": "node scripts/extract-harmony-checkpoints.mjs",
    "generate:harmony:checkpoints": "node scripts/generate-harmony-checkpoint-blocks.mjs",
    "build": "pnpm --filter @interactive-textbook/player build",
    "dev": "pnpm --filter @interactive-textbook/player dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs && vitest run",
    "test:rc1": "node --test tests/harmony-rc1-static.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "globals": "^17.0.0",
    "prettier": "^3.8.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.50.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
