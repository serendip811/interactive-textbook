{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interactive-textbook.dev/schema/book/0.2.0",
  "title": "Interactive Textbook Book",
  "type": "object",
  "required": ["id", "schemaVersion", "contentVersion", "engineVersion", "subject", "title", "language", "parts"],
  "properties": {
    "id": { "$ref": "#/$defs/id" }, "schemaVersion": { "const": "0.2.0" }, "contentVersion": { "$ref": "#/$defs/version" },
    "engineVersion": { "$ref": "#/$defs/version" }, "subject": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" }, "language": { "type": "string" }, "parts": { "type": "array", "items": { "$ref": "#/$defs/part" } }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
    "objective": { "type": "object", "required": ["id", "title"], "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "type": "string" }, "description": { "type": "string" } }, "additionalProperties": false },
    "block": { "type": "object", "required": ["id", "type", "blockVersion", "objectiveRefs", "data"], "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "type": "string", "minLength": 1 }, "blockVersion": { "const": "1.0.0" }, "objectiveRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }, "dataRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "data": true }, "additionalProperties": false },
    "lesson": { "type": "object", "required": ["id", "title", "objectives", "blocks", "completion"], "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "type": "string" }, "summary": { "type": "string" }, "estimatedMinutes": { "type": "integer", "minimum": 1 }, "prerequisiteRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "objectives": { "type": "array", "items": { "$ref": "#/$defs/objective" } }, "data": { "type": "array" }, "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } }, "completion": { "type": "object", "required": ["type"] } }, "additionalProperties": false },
    "part": { "type": "object", "required": ["id", "title", "lessons"], "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "type": "string" }, "description": { "type": "string" }, "lessons": { "type": "array", "items": { "$ref": "#/$defs/lesson" } } }, "additionalProperties": false }
  }
}
